# URL HTTPS do IXC, sem /webservice/v1
IXC_URL=https://ixc.exemplo.com.br
# IXC: credenciais do webservice, acesso somente de leitura a cliente e fn_areceber
IXC_USER_ID=
IXC_TOKEN=
# Caso utilize o header Authorization inteiro em vez de usuario/token:
# IXC_BASIC_AUTH=Basic BASE64_DE_USUARIO_DOIS_PONTOS_TOKEN
# Chave compartilhada com UM terminal autorizado (mínimo 32 caracteres aleatórios)
TERMINAL_KEY=SUBSTITUA_POR_SEGREDO_ALEATORIO_DE_32_CARACTERES
# Segredo diferente da chave do terminal (mínimo 32 caracteres)
SESSION_SECRET=SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO_32_CARACTERES
# Encaminhar novos contatos por HTTPS (ou usar SMTP abaixo)
COMMERCIAL_WEBHOOK_URL=
COMMERCIAL_WEBHOOK_TOKEN=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
COMMERCIAL_TO=
# Arquivo local de auditoria dos leads; proteger com permissões
LEADS_DB=/data/leads.db
# Deixe vazio para produção (não usar mock de cobranças)

# WhatsApp Cloud API oficial da Meta: credenciais ficam SOMENTE no Ubuntu.
# Configure no WhatsApp Manager modelos ativos/aprovados, nesta ordem de variaveis.
# Boas-vindas: {{1}} primeiro nome; {{2}} ID do cliente IXC.
# PIX quitado: {{1}} primeiro nome; {{2}} valor; {{3}} fatura; {{4}} data.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v26.0
META_TEMPLATE_LANGUAGE=pt_BR
META_TEMPLATE_WELCOME=
META_TEMPLATE_PIX=
# Somente cadastro do IXC com data recente, nunca leads ainda nao cadastrados.
META_NEW_CLIENT_MAX_DAYS=30
# Banco SQLite persistente, em volume Docker. Prevencao de envio duplicado.
META_OUTBOX_DB=/data/whatsapp_outbox.db

# Preferencial para ISM (IXC + Opa! Suite). Use os dados da instalação própria.
# Nunca informe o token aqui no chat e nunca coloque no APK.
WHATSAPP_PROVIDER=opa
OPA_BASE_URL=https://sua-instalacao-opa.exemplo.com.br
OPA_API_TOKEN=
OPA_CHANNEL_ID=
OPA_TEMPLATE_WELCOME_ID=
OPA_TEMPLATE_PIX_ID=
# Banco de deduplicação persistente no volume /data
WHATSAPP_OUTBOX_DB=/data/whatsapp_outbox.db

# NOVO INTERESSADO: alerta para a equipe comercial via Opa! Suite.
# Os dois valores abaixo são OPCIONAIS até criar um template de 4 variáveis.
# Jamais usar o ID de boas-vindas para novo interessado.
OPA_TEMPLATE_LEAD_ID=
# Número celular da equipe comercial (DDD+9+8 dígitos, destino autorizado).
OPA_COMMERCIAL_PHONE=

# OPCIONAL: iniciar contato no WhatsApp do PROPRIO interessado apos autorizacao.
# Aproveita o template existente iniciar_atendimento2 (2 variaveis):
# {{nome_cliente}} e {{nome_empresa}}.
# Ative SOMENTE apos verificar se o modelo esta pronto no Opa.
# O cliente precisa ter celular valido e autorizar o contato na maquininha.
OPA_PROSPECT_WHATSAPP_ENABLED=false
OPA_TEMPLATE_PROSPECT_ID=6aa3fcaad95fdf7490e33108

# ========================================================
# TEF / CARTAO - HOMOLOGACAO SUPERVISIONADA, PADRAO OFF
# ========================================================
# NAO habilita baixa automatica no IXC. Cada tentativa bloqueia duplicatas.
CARD_TEF_HOMOLOGATION_ENABLED=false
CARD_TEF_DB=/data/tef_attempts.db
# Dados fornecidos pela Fiserv/Getnet, nunca no APK ou chat.
MSITEF_EMPRESA=
MSITEF_ENDERECO=
MSITEF_CNPJ_ESTABELECIMENTO=
MSITEF_TERMINAL=
# Obrigatório comExterna=4 (TLS Fiserv/GWP) em Smart POS; não habilita transações sozinho.
MSITEF_COM_EXTERNA=4
MSITEF_CNPJ_AUTOMACAO=
MSITEF_CNPJ_FACILITADOR=
