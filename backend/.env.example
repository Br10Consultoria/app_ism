# URL HTTPS do IXC, sem /webservice/v1
IXC_URL=https://ixc.exemplo.com.br
# IXC: credenciais do webservice, acesso somente de leitura a cliente e fn_areceber
IXC_USER_ID=
IXC_TOKEN=
# Caso utilize o header Authorization inteiro em vez de usuario/token:
# IXC_BASIC_AUTH=Basic BASE64_DE_USUARIO_DOIS_PONTOS_TOKEN
# Chave compartilhada com UM terminal autorizado (mínimo 32 caracteres aleatórios)
TERMINAL_KEY=SUBSTITUA_POR_SEGREDO_ALEATORIO_DE_32_CARACTERES
# Segredo diferente da chave do terminal (mínimo 32 caracteres)
SESSION_SECRET=SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO_32_CARACTERES
# Encaminhar novos contatos por HTTPS (ou usar SMTP abaixo)
COMMERCIAL_WEBHOOK_URL=
COMMERCIAL_WEBHOOK_TOKEN=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
COMMERCIAL_TO=
# Arquivo local de auditoria dos leads; proteger com permissões
LEADS_DB=/data/leads.db
# Deixe vazio para produção (não usar mock de cobranças)
